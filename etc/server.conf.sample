[global]
mmdb_file = db/GeoOpen-Country.mmdb,db/GeoOpen-Country-ASN.mmdb
country_file = db/country.json
lookup_pubsub = no 
# How many reverse proxies append an address to X-Forwarded-For.
# Leave empty to keep the previous behavior (leftmost, client-controlled).
# 0: use the immediate peer and ignore forwarded headers.
# 1: one proxy in front (typical nginx). The address that proxy appended
# is used; a client cannot pick a different address by sending its own header.
trusted_hops =
port = 8000
web_ui = yes
# Public address of this instance, used in the commands shown by the web
# interface (e.g. https://ip.circl.lu). Leave empty to use the address
# the visitor opened the page with.
public_url =
# Background tiles of the web interface map, as an XYZ URL
# (e.g. https://tiles.example.org/{z}/{x}/{y}.png) and the credit shown
# under the map (HTML allowed). Leave empty to show only the country shapes.
map_tile_url =
map_tile_attribution =
